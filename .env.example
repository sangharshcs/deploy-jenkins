# Admin credentials — Jenkins controller only.
JENKINS_SERVER_IP=127.0.0.1
JENKINS_USER=admin
JENKINS_PASS=

# Dedicated agent account — workers only, never the admin password.
# Use a separate strong password; store both in a password manager.
AGENT_USER=agent
AGENT_PASS=

# Optional values
UI_PORT=8080
DOCKERHUB_NAMESPACE=sangharshcs
# CONTROLLER_IMAGE_REPO=sangharshcs/jenkins-controller
# WORKER_IMAGE_REPO=sangharshcs/jenkins-worker
WORKER_REPLICAS=1

# Worker tuning
# SWARM_EXECUTORS=5
# SWARM_LABELS=swarm docker
# SWARM_WEBSOCKET=true

# Explicit controller URL for workers.  Set this when TLS terminates on an
# external reverse proxy at a different port or hostname, e.g.:
#   JENKINS_CONTROLLER_URL=https://jenkins.example.com/jenkins
# If unset, deploy.sh derives it from JENKINS_SERVER_IP and UI_PORT (HTTP only).
# JENKINS_CONTROLLER_URL=

# Stack name (must match between deploy.sh and stop.sh if overridden)
# STACK_NAME=jenkins

# Controller data persists on the host; each worker has an ephemeral workspace
# at WORKER_ROOT inside its own container.
CONTROLLER_ROOT=/tmp/jenkins_home
WORKER_ROOT=/tmp/worker_home

# Optional deploy tag override
# DEPLOY_TAG=local-dev
